{
  "name": "ghost-library-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Maintain ghost-library specifications, portable fixtures, and downstream conformance evidence.",
  "license": "MIT",
  "author": {
    "name": "Hasan Sezer Tasan",
    "url": "https://github.com/hasansezertasan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hasansezertasan/ghost-library-skills"
  },
  "keywords": [
    "ghost-library",
    "specifications",
    "conformance",
    "skills",
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "ai-rulez generate --no-self-mcp --strict-config && ai-rulez generate --plugin",
    "check": "node scripts/check-repo.mjs && ai-rulez generate --check --no-self-mcp --strict-config && ai-rulez verify --plugin && ai-rulez validate --strict",
    "test": "PYTHONDONTWRITEBYTECODE=1 ${PYTHON:-python3} -m unittest discover -s tests -v",
    "build": "${PYTHON:-python3} tools/build_plugins.py --output \"${OUTPUT:-dist/plugins}\"",
    "postcheck": "${PYTHON:-python3} tools/check_owned_tree.py"
  },
  "devDependencies": {
    "ai-rulez": "5.3.0"
  }
}
